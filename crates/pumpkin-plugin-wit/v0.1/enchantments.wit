package pumpkin:plugin@0.1.0;

interface enchantments {
  use text.{text-component};

  /// Equipment slot where an enchantment is active.
  enum attribute-modifier-slot {
    any,
    main-hand,
    off-hand,
    hand,
    feet,
    legs,
    chest,
    head,
    armor,
    body,
    saddle,
  }

  /// Vanilla enchantments enum.
  enum enchantment {
    aqua-affinity,
    bane-of-arthropods,
    binding-curse,
    blast-protection,
    breach,
    channeling,
    density,
    depth-strider,
    efficiency,
    feather-falling,
    fire-aspect,
    fire-protection,
    flame,
    fortune,
    frost-walker,
    impaling,
    infinity,
    knockback,
    looting,
    loyalty,
    luck-of-the-sea,
    lunge,
    lure,
    mending,
    multishot,
    piercing,
    power,
    projectile-protection,
    protection,
    punch,
    quick-charge,
    respiration,
    riptide,
    sharpness,
    silk-touch,
    smite,
    soul-speed,
    sweeping-edge,
    swift-sneak,
    thorns,
    unbreaking,
    vanishing-curse,
    wind-burst,
  }

  /// Represents a custom enchantment definition.
  record custom-enchantment {
    /// Unique identifier for the enchantment (e.g. "my_plugin:lifesteal").
    id: string,
    /// Description or display name of the enchantment.
    description: text-component,
    /// Maximum level of the enchantment (e.g. 1..=10).
    max-level: u32,
    /// Base anvil repair/combination cost multiplier.
    anvil-cost: u32,
    /// Tag or item pattern for supported items (e.g. "#minecraft:enchantable/weapon").
    supported-items: string,
    /// Weight / rarity of the enchantment (higher = more common, default 5).
    weight: u32,
    /// Equipment slots where this enchantment is active.
    slots: list<attribute-modifier-slot>,
    /// List of exclusive/conflicting enchantment IDs.
    exclusive-set: list<string>,
  }

  /// Enchanting level range for an enchantment level: `base + per-level-above-first * (level - 1)`.
  record enchantment-cost {
    base: s32,
    per-level-above-first: s32,
  }

  /// How players can obtain a custom enchantment, beyond being applied by a plugin.
  record enchantment-options {
    /// Minimum enchanting level for each enchantment level.
    min-cost: enchantment-cost,
    /// Maximum enchanting level for each enchantment level.
    max-cost: enchantment-cost,
    /// Offered by the enchanting table.
    in-enchanting-table: bool,
    /// Sold on enchanted books by librarian villagers.
    tradeable: bool,
    /// Treasure: never offered by the enchanting table, and costs double from librarians.
    treasure: bool,
    /// A curse: kept by the grindstone and shown in red.
    curse: bool,
  }

  /// Global manager for registering and querying custom enchantments.
  ///
  /// Registered enchantments are real enchantments: clients show them in tooltips, and the
  /// enchanting table, anvil, grindstone and librarians handle them like vanilla ones.
  /// Clients learn the enchantment list when they join, so an enchantment first registered
  /// after players have joined is rejected until the server restarts. Registering an
  /// already-registered id again succeeds and keeps the original definition.
  resource enchantment-manager {
    /// Registers a new custom enchantment with the server, obtainable only through plugins.
    register-enchantment: func(enchantment: custom-enchantment) -> result<_, string>;

    /// Registers a new custom enchantment with options for how players can obtain it.
    register-enchantment-with-options: func(enchantment: custom-enchantment, options: enchantment-options) -> result<_, string>;

    /// Gets an enchantment definition by its ID.
    get-enchantment: func(id: string) -> option<custom-enchantment>;

    /// Checks if an enchantment ID is registered.
    has-enchantment: func(id: string) -> bool;

    /// Returns all registered custom enchantment IDs.
    get-all-enchantment-ids: func() -> list<string>;
  }
}
